                  conf = conf,                            ## MCMC configuration
                  bite.size = 250,                        ## Number of iterations per bite
                  bite.number = 10000,                        ## Number of MCMC bites
                  path = paste0("DeerAllOct", "/chain",c),          ## Directory where MCMC outputs will be saved
                  save.rds = TRUE)                        ## Option to save the state of the model 
  }) #this will take awhile and not produce any noticeable output.
)
