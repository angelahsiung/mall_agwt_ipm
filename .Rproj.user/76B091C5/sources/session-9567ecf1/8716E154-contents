## The figures below contain the important population parameter estimates of the mallard IPM based on different ways to model the observation error in the state-space model. The alternatives are modeling Bpop as an outcome of a Poisson distribution (poisson mod) versus an outcome of a normal distribution while providing an informed prior for the standard deviation (sig.t ~ dgamma(5, 0.1))

```{r}
#| echo: false
library(tidyverse)
mall.ipm.gamma <- readRDS('mallard_gamma_mod.rds')
mall.ipm.pois <- readRDS('mall_ipm_y_tot_dpois_N_tot.rds')

```
## fall/winter survival by model
```{r, fig.width=10,fig.height=8}

survFW <- data.frame(cbind(Year = rep(c(2000:2019), 8), 
                              Class = rep(rep(c("Juvenile Male", "Juvenile Female", "Adult Male", "Adult Female"), each = length(mall.ipm.gamma$mean$SH.jm)), 2), 
                              Model = rep(c("gamma mod", "poisson mod"), each = 80 #116
                                           ), 
                              Mean = c(mall.ipm.gamma$mean$SH.jm, mall.ipm.gamma$mean$SH.jf, mall.ipm.gamma$mean$SH.am, mall.ipm.gamma$mean$SH.af, mall.ipm.pois$mean$SH.jm, mall.ipm.pois$mean$SH.jf, mall.ipm.pois$mean$SH.am, mall.ipm.pois$mean$SH.af), 
                              Lower = c(mall.ipm.gamma$q2.5$SH.jm, mall.ipm.gamma$q2.5$SH.jf, mall.ipm.gamma$q2.5$SH.am, mall.ipm.gamma$q2.5$SH.af, mall.ipm.pois$q2.5$SH.jm, mall.ipm.pois$q2.5$SH.jf, mall.ipm.pois$q2.5$SH.am, mall.ipm.pois$q2.5$SH.af), 
                              Upper = c(mall.ipm.gamma$q97.5$SH.jm, mall.ipm.gamma$q97.5$SH.jf, mall.ipm.gamma$q97.5$SH.am, mall.ipm.gamma$q97.5$SH.af, mall.ipm.pois$q97.5$SH.jm, mall.ipm.pois$q97.5$SH.jf, mall.ipm.pois$q97.5$SH.am, mall.ipm.pois$q97.5$SH.af)))

survFW <- survFW %>% 
                mutate_at(c("Mean", "Lower", "Upper"), as.numeric)

ggplot(survFW, aes(x = Year, y = Mean, group = Model)) +
  geom_pointrange(aes(ymin = Lower, ymax = Upper, color = Model), size = 0.2, alpha = 0.75, position=position_dodge(width=0.35)) +
  # theme_ipm() +
  scale_color_manual(values=c("royalblue3", "firebrick3"))+ 
  ylab("Survival probability") +
  scale_x_discrete(breaks = seq(2000, 2019, by = 2)) +
  facet_wrap(~Class)
```

